# ─────────────────────────────────────────────
# LeetCAD – Environment Variables
# Copy to .env and adjust values for your environment
# ─────────────────────────────────────────────

# ── Server ───────────────────────────────────
PORT=3000
REALTIME_PORT=3001

# ── PostgreSQL ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=leetcad
DB_PASSWORD=leetcad_dev
DB_NAME=leetcad_db
DB_SSL=false

# ── Redis ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── RabbitMQ ─────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── MinIO / S3 / Cloudflare R2 ──────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=leetcad
S3_SECRET_KEY=leetcad_dev
S3_BUCKET=leetcad
S3_FORCE_PATH_STYLE=true

# ── Security & Auth ──────────────────────────
JWT_SECRET=super-secret-key-change-in-prod
JWT_EXPIRES_IN=7d

# ── External APIs ────────────────────────────
GEMINI_API_KEY=
