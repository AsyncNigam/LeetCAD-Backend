# ─────────────────────────────────────────────
# LeetCAD – Environment Variables
# Copy to .env and adjust values for your environment
# ─────────────────────────────────────────────

# ── Server ───────────────────────────────────
PORT=3000
REALTIME_PORT=3001

# ── PostgreSQL (Neon DB) ─────────────────────
DATABASE_URL=

# ── Redis ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── RabbitMQ ─────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── Cloudflare R2 ────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=

# ── Security & Auth ──────────────────────────
JWT_SECRET=super-secret-key-change-in-prod
JWT_EXPIRES_IN=7d

# ── External APIs ────────────────────────────
GEMINI_API_KEY=
